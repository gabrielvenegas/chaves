# AI provider credentials are configured interactively.
# Run `chaves --setup` to use ChatGPT/Codex subscription login or an OpenRouter
# API key. Chaves does not read either provider credential from this file.

# Debug Mode
# Set to "true" to enable verbose debug logs
# Default: disabled
# CHAVES_DEBUG=true

# Index codebase on startup
# Set to "false" to skip indexing at startup
# Default: enabled
# CHAVES_INDEX_ON_START=true
