# OpenRouter API Key
# Get your API key at https://openrouter.ai/
# Required for AI-powered summary generation
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Debug Mode
# Set to "true" to enable verbose debug logs
# Default: disabled
# CHAVES_DEBUG=true

# Index codebase on startup
# Set to "false" to skip indexing at startup
# Default: enabled
# CHAVES_INDEX_ON_START=true
