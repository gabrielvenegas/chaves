{
  "name": "chaves",
  "version": "0.1.1",
  "type": "module",
  "description": "AI coding companion with real-time activity monitoring and contextual assistance in your terminal.",
  "license": "MIT",
  "bin": {
    "chaves": "bin/chaves.js"
  },
  "files": [
