    "setup": "tsx src/index.ts --setup",
    "setup:project": "tsx src/index.ts --setup",
    "setup:project:path": "./scripts/setup-project.sh",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/openai": "1.3.24",
    "@ai-sdk/provider": "1.1.3",
    "@openrouter/ai-sdk-provider": "^0.5.0",
    "@types/diff": "^8.0.0",
    "ai": "^4.0.0",
    "better-sqlite3": "^11.0.0",
    "chalk": "^5.3.0",
    "chokidar": "^3.6.0",
    "diff": "^8.0.3",
    "open": "10",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
